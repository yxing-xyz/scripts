// DMS Window Rules - Managed by Dux Shell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_0 @name=Alacritty
window-rule {
    match app-id="Alacritty"
    open-on-workspace "1"
}

// @id=dms_rule_1 @name=google-chrome
window-rule {
    match app-id="google-chrome"
    open-on-workspace "2"
}

// @id=dms_rule_2 @name=
window-rule {
    match app-id="emacs"
    open-on-workspace "3"
}

// @id=dms_rule_3 @name=code
window-rule {
    match app-id="code"
    open-on-workspace "3"
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
